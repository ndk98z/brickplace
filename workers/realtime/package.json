{
  "name": "@brickplace/realtime",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "description": "WebSocket fan-out. Deploy rarely: every deploy drops all of this script's sockets.",
  "exports": {
    ".": "./src/index.ts",
    "./player": "./src/player.ts"
  },
  "scripts": {
    "types": "wrangler types --include-env=false",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist"
  },
  "dependencies": {
    "@brickplace/protocol": "workspace:*"
  },
  "devDependencies": {
    "@brickplace/core": "workspace:*",
    "@brickplace/game": "workspace:*",
    "@cloudflare/vitest-plugin": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
