{
  "name": "@brickplace/gateway",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "description": "Edge entry point: auth, Turnstile, routing, static client. Holds no DOs, so it deploys freely.",
  "scripts": {
    "types": "wrangler types --include-env=false",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist"
  },
  "devDependencies": {
    "@brickplace/client": "workspace:*",
    "@brickplace/game": "workspace:*",
    "@brickplace/realtime": "workspace:*",
    "@cloudflare/vitest-plugin": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
