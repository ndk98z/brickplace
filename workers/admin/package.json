{
  "name": "@brickplace/admin",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "description": "Admin area behind Cloudflare Access: config versions, audit log, emergency switches, seasons, moderation. Holds no DOs.",
  "scripts": {
    "types": "wrangler types --include-env=false",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist"
  },
  "dependencies": {
    "@brickplace/core": "workspace:*",
    "@brickplace/game": "workspace:*",
    "@brickplace/realtime": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
