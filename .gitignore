# No trailing slash: a node_modules that is a symlink (older session worktrees) would not
# match `node_modules/`, leaving the worktree permanently dirty.
node_modules
dist/
coverage/
.turbo/
.wrangler/
*.log
.DS_Store

# Secrets never leave the developer's machine.
.dev.vars
.dev.vars.*
!.dev.vars.example
.env
.env.*
!.env.example

# Owner's moderation data and abuse thresholds (word list, KV caps) until the private ops
# repo exists: never committed, this repo goes public (AGENTS.md).
ops-private/

# Personal Claude Code files.
CLAUDE.local.md
.claude/settings.local.json

# Generated by `pnpm types` (turbo runs it before typecheck, test and build).
worker-configuration.d.ts

# Harness: per-session state (plans, review receipts, stop strikes) and session worktrees.
.claude/state/
.claude/worktrees/
